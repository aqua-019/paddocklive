# Copy to .env.local for `node scripts/dev.mjs`, and set the same names in Vercel → Settings → Environment Variables.
# Every service is optional: without its variable the site still runs and says plainly what isn't switched on.

# Email (Resend). Without a key, enquiries are not emailed and visitors are offered a pre-filled email instead.
RESEND_API_KEY=
ENQUIRY_TO=fitzferalhunters1@gmail.com
# Leave unset until fitzferalhunters.com is verified in Resend; until then mail goes from onboarding@resend.dev,
# which only delivers to the address the Resend account was created with (so create it with fitzferalhunters1@gmail.com).
# Then: ENQUIRY_FROM=Fitz Feral Hunters <enquiries@fitzferalhunters.com>   — full steps in docs/resend-setup.md
ENQUIRY_FROM=
# 1 = send the customer an automatic "thanks" (only works once ENQUIRY_FROM is on a verified domain)
AUTO_REPLY=

# Store (Upstash Redis via the Vercel Marketplace; the integration sets these). Needed for reviews, enquiry log, rate limits.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (older/other Upstash installs use these names instead — either pair works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the review moderation links in Fitz's emails, the review links he sends customers, and the key to his
# review-link page (/review/invite). Any 32+ random characters; changing it invalidates all of those links.
REVIEW_SECRET=

# Bot check (Cloudflare Turnstile, optional). The site key goes in content/site.json → turnstile_site_key.
TURNSTILE_SECRET_KEY=

# Review photos (Vercel Blob, PRIVATE store). Create it in Vercel → Storage → Blob with access "Private" and connect it
# to this project; that sets this variable. Without it the review form has no photo picker. Site media stays in public/media.
BLOB_READ_WRITE_TOKEN=

# Base URL used in moderation links if the request host isn't the public one (e.g. https://fitzferalhunters.com.au).
SITE_URL=

# Local only: the in-memory review store for scripts/dev.mjs and tests. Never set on Vercel.
FFH_MEMORY_STORE=
